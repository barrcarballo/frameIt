[Unit]
Description=FrameIt - servidor HTTP/HTTPS principal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barbarac
WorkingDirectory=/home/barbarac/frameIt
ExecStart=/usr/bin/python3 /home/barbarac/frameIt/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
